# -----------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` is git-ignored. Real secrets belong in your
# CI secret store (GitHub Secrets / Azure DevOps variable groups), never in Git.
# Precedence: real environment variables > .env.<TEST_ENV> > .env > JSON defaults.
# -----------------------------------------------------------------------------

# Target environment: local | dev | qa | uat | staging | prod
TEST_ENV=local

# Optional overrides of config/environments/<env>.json
BASE_URL=
API_BASE_URL=

# Role-based credentials: APP_<ROLE>_USERNAME / APP_<ROLE>_PASSWORD
# (Roles are declared per environment in config/environments/<env>.json.)
# Always quote values containing "#" (dotenv treats an unquoted # as a comment).
# NOTE: plain USERNAME is intentionally NOT used – it is a reserved OS variable on Windows.
# The values below are the built-in accounts of the bundled demo app (local env only).
APP_ADMIN_USERNAME=admin@demo.local
APP_ADMIN_PASSWORD="Admin#12345"
APP_VIEWER_USERNAME=viewer@demo.local
APP_VIEWER_PASSWORD="Viewer#12345"

# OAuth2 client credentials (demo app values for local env)
API_CLIENT_ID=demo-client
API_CLIENT_SECRET=demo-client-secret

# Execution
WORKERS=
RETRIES=
HEADLESS=true
MOBILE=false

# Production safety (prod is read-only unless BOTH are set; DELETE is always blocked)
ALLOW_PROD_WRITES=false
PROD_WRITE_ALLOWLIST=

# Logging: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
LOG_CONSOLE_LEVEL=warn

# LLM (optional – standard test suites never require these)
# LLM_PROVIDER: none | openai | anthropic | openrouter | ollama
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Test Console (npm run console) – provider/model/API key are set in the UI (⚙ Model settings) and stored
# encrypted; LLM_* above is only a fallback. Optional secret-store overrides:
# CONSOLE_SECRETS_FILE=.secrets/llm-settings.enc.json
# CONSOLE_MASTER_KEY_FILE=~/.playwright-test-console/master.key
# CONSOLE_MASTER_KEY=   (passphrase instead of a key file, min. 16 chars)
CONSOLE_PORT=4100
# Comma-separated hostnames the console may test ("*.example.com" allowed); empty = any public site
CONSOLE_ALLOWED_HOSTS=
CONSOLE_RUN_TIMEOUT_MS=1200000
# Allow localhost/intranet targets (blocked by default; metadata/link-local always blocked)
CONSOLE_ALLOW_PRIVATE_NETWORK=false

# MCP server governance
MCP_ALLOWED_ENVIRONMENTS=local,dev,qa
MCP_TOOL_TIMEOUT_MS=600000
# Comma-separated allowlist; empty = all built-in tools enabled
MCP_ENABLED_TOOLS=
# Required only for the optional Streamable HTTP server (npm run mcp:http)
MCP_HTTP_TOKEN=
MCP_HTTP_PORT=3333

# Hosted Test Console (npm run web:dev locally; set these as Vercel environment variables in production)
# Google OAuth client – redirect URI: <app-url>/api/auth/callback (see docs/web-app.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# >= 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Optional: restrict sign-in (e.g. gmail.com) / addresses, restrict target sites, runs per user per hour
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
ALLOWED_TARGET_HOSTS=
RUNS_PER_HOUR=10
WEB_PORT=3100
