{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Playwright + TypeScript UI & API automation framework with MCP and LLM integration",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "clean": "tsx scripts/clean.ts",
    "demo:start": "tsx demo-app/server.ts",
    "test": "tsx scripts/run-tests.ts --",
    "test:ui": "tsx scripts/run-tests.ts -- tests/ui",
    "test:api": "tsx scripts/run-tests.ts -- --project=api",
    "test:e2e": "tsx scripts/run-tests.ts -- tests/e2e tests/integration",
    "test:smoke": "tsx scripts/run-tests.ts -- --grep @smoke",
    "test:regression": "tsx scripts/run-tests.ts -- --grep @regression",
    "test:critical": "tsx scripts/run-tests.ts -- --grep @critical",
    "test:headed": "tsx scripts/run-tests.ts -- --project=chromium --headed",
    "test:debug": "tsx scripts/run-tests.ts --skip-typecheck -- --project=chromium --debug",
    "test:chromium": "tsx scripts/run-tests.ts -- --project=chromium",
    "test:firefox": "tsx scripts/run-tests.ts -- --project=firefox",
    "test:webkit": "tsx scripts/run-tests.ts -- --project=webkit",
    "test:mobile": "tsx scripts/run-tests.ts --mobile -- --project=mobile-chrome --project=mobile-safari",
    "test:local": "tsx scripts/run-tests.ts --env local --",
    "test:dev": "tsx scripts/run-tests.ts --env dev --",
    "test:qa": "tsx scripts/run-tests.ts --env qa --",
    "test:uat": "tsx scripts/run-tests.ts --env uat --",
    "test:staging": "tsx scripts/run-tests.ts --env staging --",
    "test:prod-health": "tsx scripts/run-tests.ts --env prod -- --project=api --grep @prod-safe",
    "test:framework": "tsx scripts/run-tests.ts -- --project=framework-unit --project=framework-integration",
    "report": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:allure:open": "allure open reports/allure-report",
    "reports:merge": "tsx scripts/merge-reports.ts",
    "data:generate": "tsx scripts/generate-test-data.ts",
    "mcp:server": "node dist/mcp/server/index.js",
    "mcp:server:dev": "tsx src/mcp/server/index.ts",
    "mcp:http": "node dist/mcp/server/http.js",
    "mcp:playwright": "playwright-mcp --headless --isolated",
    "mcp:example": "tsx scripts/mcp-client-example.ts",
    "ai:check": "tsx scripts/llm-check.ts",
    "console": "tsx src/console/main.ts",
    "test:generated": "playwright test -c playwright.generated.config.ts",
    "web:build": "tsx scripts/build-web.ts",
    "web:dev": "tsx scripts/web-dev.ts",
    "audit:deps": "npm audit --audit-level=high",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run build && tsx scripts/run-tests.ts --skip-typecheck"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/mcp": "0.0.85",
    "@playwright/test": "1.65.1",
    "@sparticuz/chromium": "153.0.0",
    "dotenv": "18.0.10",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "playwright-core": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
