{
  "openapi": "3.1.0",
  "info": { "title": "Demo Admin Portal API", "version": "1.4.0" },
  "servers": [{ "url": "http://localhost:4000/api" }],
  "security": [{ "bearerAuth": [] }, { "basicAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "basicAuth": { "type": "http", "scheme": "basic" }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id", "firstName", "lastName", "email", "role", "status", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "firstName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "lastName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "role": { "type": "string", "enum": ["admin", "editor", "viewer"] },
          "status": { "type": "string", "enum": ["active", "inactive"] },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["firstName", "lastName", "email", "role"],
        "properties": {
          "firstName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "lastName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["admin", "editor", "viewer"] },
          "status": { "type": "string", "enum": ["active", "inactive"] }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "field": { "type": "string" }, "message": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [],
        "responses": { "200": { "description": "Healthy" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Password grant - returns access and refresh tokens",
        "security": [],
        "responses": {
          "200": { "description": "Tokens" },
          "400": { "description": "Missing fields" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Rotate a refresh token (single use)",
        "security": [],
        "responses": {
          "200": { "description": "New tokens" },
          "401": { "description": "Invalid or reused refresh token" }
        }
      }
    },
    "/oauth/token": {
      "post": {
        "summary": "OAuth2 client credentials grant",
        "security": [],
        "responses": {
          "200": { "description": "Access token" },
          "400": { "description": "Unsupported grant" },
          "401": { "description": "Invalid client" }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "List users (paginated)",
        "security": [{ "bearerAuth": [] }, { "basicAuth": [] }],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          {
            "name": "role",
            "in": "query",
            "schema": { "type": "string", "enum": ["admin", "editor", "viewer"] }
          },
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 10000 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }
        ],
        "responses": {
          "200": { "description": "Page of users" },
          "400": { "description": "Invalid query" },
          "401": { "description": "Unauthenticated" }
        }
      },
      "post": {
        "summary": "Create user (admin/editor). Supports Idempotency-Key header.",
        "security": [{ "bearerAuth": [] }, { "basicAuth": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserRequest" } }
          }
        },
        "responses": {
          "201": { "description": "Created (Location header set)" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthenticated" },
          "403": { "description": "Forbidden for role" },
          "409": { "description": "E-mail conflict" },
          "422": { "description": "Idempotency key reused with different payload" }
        }
      }
    },
    "/users/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "summary": "Get user",
        "responses": { "200": { "description": "User" }, "404": { "description": "Not found" } }
      },
      "put": {
        "summary": "Replace user (admin/editor)",
        "responses": {
          "200": { "description": "Updated" },
          "400": { "description": "Validation error" },
          "404": { "description": "Not found" }
        }
      },
      "patch": {
        "summary": "Partially update user (admin/editor)",
        "responses": {
          "200": { "description": "Updated" },
          "400": { "description": "Validation error" },
          "404": { "description": "Not found" }
        }
      },
      "delete": {
        "summary": "Delete user (admin only)",
        "responses": {
          "204": { "description": "Deleted" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Not found" },
          "409": { "description": "Built-in account" }
        }
      }
    },
    "/stats": {
      "get": { "summary": "Dashboard statistics", "responses": { "200": { "description": "Stats" } } }
    }
  }
}
